# PaySentinel environment template — copy to .env and fill in.

# Anthropic (primary LLM)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: route through a proxy
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Backend
PAYSENTINEL_ENV=dev
PAYSENTINEL_LOG_LEVEL=INFO
PAYSENTINEL_DATA_DIR=./data
PAYSENTINEL_RESULTS_DIR=./results
PAYSENTINEL_RANDOM_SEED=42

# Defend service
DEFEND_SCORING_BUDGET_MS=50

# Web prototype
NEXT_PUBLIC_API_BASE=http://localhost:8000
